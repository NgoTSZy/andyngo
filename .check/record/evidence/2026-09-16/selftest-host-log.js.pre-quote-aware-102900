  /* ---- 33..35 · `[98]` 的**展示层**（combinePair）----
   * 这段只有等日报真的跑过一次才会被执行到 —— **没跑过的代码崩起来是一行结论都没有**
   * （TDZ 那次已经领教过：ReferenceError → 整条命令一行不打、退出码 1）。
   * 所以把它提成纯函数在这里跑掉。 */
  const P_OK = { state: 'OK', run: RUN, line: L(T + 4 * 60000), cand: 1, deltaMs: 4 * 60000, why: '' };
  const Q_OK = { state: 'OK', causal: true, cmd: CMD, line: L(T + 4 * 60000), cand: 1, deltaMs: 240000, why: '' };
  const Q_UNV = { state: 'UNVERIFIED', causal: false, why: '拿不到会话日志' };
  const Q_FAIL = { state: 'FAIL', causal: true, why: '会话里没有执行那条命令' };

  const k33 = combinePair(P_OK, Q_OK);
  check('33 因果成立时 -> state 取因果那条，且明细写明「因果已确认」',
    { state: k33.state, 因果已确认: /因果已确认/.test(k33.causalTxt), 命令执行: /命令执行/.test(k33.pairTxt) },
    { state: 'OK', 因果已确认: true, 命令执行: true });

  const k34 = combinePair(P_OK, Q_UNV);
  check('34 因果没确认 -> **退回**时间窗口，且 why 里**两个都讲**（不许只报一个）',
    { state: k34.state, 因果未确认: /因果未确认/.test(k34.causalTxt),
      退回: /时间窗口配对/.test(k34.why), 拿不到: /拿不到会话日志/.test(k34.why) },
    { state: 'OK', 因果未确认: true, 退回: true, 拿不到: true });

  const k35 = combinePair(P_OK, Q_FAIL);
  check('35 因果那条是 FAIL -> 不许被时间窗口的 OK 盖掉（弱证据不许顶掉强结论）',
    { state: k35.state, 没有执行: /没有执行/.test(k35.why) },
    { state: 'FAIL', 没有执行: true });

  /* ---- 8 · findHookTrace 指针链（[99] 自述那侧的落点） ----
   * 2026-09-15 翻案的直接原因：`[99]` 一直读 `.check/hook.log`（0 行），
   * 而真正的落点在别处。**读错落点 = 拿「读不到」当「没发生」**，形状与 `src=host` 那次一致。
   * 所以落点不许写死，走指针链 —— 链本身也要有守门，否则哪天被搬走又会静默变 0。 */
  const HOOKJS = path.join(ROOT4, '.check', 'immunity-hook.js');
  const TRACEF = path.join(ROOT4, 'immunity', 'host-hook-spawns.log');
  const esc2 = (s) => s.replace(/\\/g, '\\\\');   // 真实脚本里 TRACE 是转义过的反斜杠
  mk(ROOT4, 'settings.json', JSON.stringify({
    hooks: { PostToolUse: [{ matcher: 'Write|Edit', hooks: [{ type: 'command',
      command: '"C:\\node.exe" "' + HOOKJS + '"' }] }] } }));
  /* fixture 用**当前真相的形状**（`process.env.IMMUNITY_TRACE || '…'`）。
   * 2026-09-15 就是这里没跟上：hook 的 TRACE 改成可覆盖之后，解析正则还认旧形状，
   * `[99]` 当场 FAIL「spawn 了但没产出」。**用例的形状必须跟代码一起改。** */
  mk(ROOT4, '.check/immunity-hook.js',
     "const TRACE = process.env.IMMUNITY_TRACE\n  || '" + esc2(TRACEF) + "';\n");
  mk(ROOT4, 'immunity/host-hook-spawns.log', [
    'ts=2026-09-15T08:00:00.000Z pid=1 verdict=ok fp=/a rc=0',
    'ts=2026-09-15T08:00:01.000Z pid=2 verdict=non-clean:rc=2 fp=/b rc=2',
    'ts=2026-09-15T08:00:02.000Z pid=3 verdict=bad-json input_len=0 rc=0',
  ].join('\n') + '\n');

  const trA = findHookTrace(ROOT4);
  const mTs = trA.last ? /ts=(\S+)/.exec(trA.last) : null;
  /* 这个 fixture 里恰好三行齐全：`ok` / `non-clean:rc=2` / `bad-json` ——
   * 于是 `unchecked`（没走到检查）= 1、`incomplete`（检查没跑完）= 1，两边都能被断言到。 */
  check('37 指针链 settings.json -> hook 脚本 -> TRACE 能解出落点，且 verdict 分形状计数',
    { path: trA.path, n: trA.n, ok: trA.verdicts.ok, nonclean: trA.verdicts['non-clean:rc=2'],
      badjson: trA.verdicts['bad-json'], rcNonZero: trA.rcNonZero, lastTs: mTs && mTs[1],
      unchecked: trA.unchecked, incomplete: trA.incomplete },
    { path: esc2(TRACEF), n: 3, ok: 1, nonclean: 1, badjson: 1, rcNonZero: 1,
      lastTs: '2026-09-15T08:00:02.000Z', unchecked: 1, incomplete: 1 });

  /* 链断了必须**报出来**，不许静默返回 n=0 —— 静默的 0 会被读成「hook 从没跑过」。 */
  mk(ROOT4, '.check/immunity-hook.js', 'const NOTHING = 1;\n');
  const trB = findHookTrace(ROOT4);
  check('38 脚本里没有 TRACE -> 给 why，不许静默 n=0（静默的 0 会被读成「没发生」）',
    { path: trB.path, n: trB.n, 有why: !!trB.why },
    { path: null, n: 0, 有why: true });

  /* **两种形状都要认**。解析器只认一种形状 = 换个写法就静默变 0，
   * 而静默的 0 会被下游读成「hook 从没跑过」。向后兼容不是「顺手」：
   * 脚本可能被回滚、被重装成旧版，判据不能跟着一起烂。 */
  mk(ROOT4, '.check/immunity-hook.js', "const TRACE = '" + esc2(TRACEF) + "';\n");
  const trC = findHookTrace(ROOT4);
  check("47 旧形状（裸字面量 `TRACE = '…'`）也要能认 —— 解析器不许只认一种形状",
    { path: trC.path, n: trC.n }, { path: esc2(TRACEF), n: 3 });

  /* ---- 39-42：宿主退出码 ↔ hook 自述 verdict 的**交叉核对**（2026-09-15 加） ----
   * 为什么要自测：真实环境里「宿主 > 自述」这一支**等不到**（那是异常），
   * 而它恰恰是这条判据存在的理由 —— 走不到的分支和不存在的分支，在验收表上长得一样。
