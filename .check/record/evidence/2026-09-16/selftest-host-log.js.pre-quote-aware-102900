  check('30 跨天那一轮能算出自己的日期目录（会话日志按日期分目录）',
    { d: dayOf(Date.parse('2026-09-15T17:30:00+08:00')) }, { d: '2026-09-15' });

  /* ---- 31 · `sdk/conversations/` **必须**被扫到 ----
   * 2026-09-15 实测：automation 那一轮的会话日志在 `logs/<日期>/sdk/conversations/`，
   * **不在顶层**；而 `[HookExecutor] spawn` 在那个文件里也出现。
   * 漏掉它的后果不是「少看一点」：[99] 说的是一句**否定**（「宿主从未 spawn 过它」），
   * 而否定的强度不能超过证据的覆盖范围。这条是那个覆盖缺口的守门人。 */
  /* 路径分隔符用**正斜杠**：真实日志里 hook 是 `.check/hook-post-edit.js`
   * （第一次写这条用例我全用了反斜杠，于是 `.check/` 这个特征子串根本不在行里 ——
   * 用例自己就构不造成立条件，跑了也是假绿。**写用例先确认特征串真的出现。**） */
  mk(ROOT4, path.join(dayOf(Date.now()), 'sdk', 'conversations', 'sess-1.log'),
    logline(new Date().toISOString(),
      '[HookExecutor] spawn cmd=node C:/Users/x/.check/hook-post-edit.js'));
  const s31 = scanHostLogs(ROOT4);
  check('31 扫到 sdk/conversations/ 里的会话日志（覆盖缺口守门人）',
