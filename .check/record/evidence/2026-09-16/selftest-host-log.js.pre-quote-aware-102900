#!/usr/bin/env node
'use strict';
/* selftest-host-log.js —— 给 `.check/host-log.js` 的自测（用**合成 fixture**）。
 *
 * 为什么要有它：`acceptance.js` 里有两处判定**在真实环境里等不到**：
 *   · [99]（hook）的 OK 分支 —— 需要宿主真的加载并调用一次 hook，
 *     而那要人先在 `/hooks` 面板放行（人工审批闸门）。
 *   · [98]（automation 产出）的 OK / FAIL 分支 —— 要等那条日报真的跑到第二次。
 * 我在验收里写过「这个分支没测过」—— **那条免责声明本身就是待办事项。**
 * 这里用合成日志把判定逻辑整个跑一遍：**不证明真实环境如何，只证明这段解析对。**
 *
 * 为什么必须是合成 fixture 而不是改真日志：
 * 2026-09-15 我为了测标记，**亲手往真日志里伪造了 4 行** `src=host`，
 * 留下了一条会误导后来人的假绿。**测试不许写进真日志。**
 *
 * 关键用例，各自对应一个真实踩过的坑：
 *   · 第 1 条：**我自己的 Bash 调用也含 `.check/`**，不许被算成「宿主调用了 hook」
 *   · 第 6 条：automation 的 `execute result` 行**不是**运行记录，
 *     只有 `terminal run record written` 才是 —— 都算会重复计数
 *   · 第 8 条：automation 的行在**根目录的 daemon.log** 里，不在日期目录里
 *   · 第 9 条：取不到时间戳就报 null，**不许拿「现在」顶替** —— 那会把配对悄悄挪到当下
 *   · 第 11 条：「没有运行记录」是**未到点**，与「跑了但没产出」不是一回事
 *
 * 【fixture 的代表性】第 6/7 条原来用的是**裸文本行**（`[Info] [AutomationRecords] …`），
 * 而真实日志行是**带 `"timestamp"` 的 JSON**。加了时间戳解析之后那两条当场红 ——
 * 不是代码错，是**用例不真实**。已改成 `logline()` 生成真形状的行。
 * 「一份用假数据自证能工作的测试，证明的只是它能处理假数据。」
 */
const fs = require('fs');
const os = require('os');
const path = require('path');
const { scanHostLogs, parseLedger, pairRunWithLedger, causalPair, combinePair,
        parseHostTs, dayOf, findHookTrace, crossCheckHookExit, judgeHookTrace,
        findSessionAcceptanceRuns, parseWorkspaceTs, cmdRunsAcceptance,
        PAIR_AFTER_MS, PAIR_MAX_AGE_MS } =
  require('./host-log.js');

const ROOT = path.join(os.tmpdir(), 'hostlog-selftest-' + process.pid);
const ROOT2 = path.join(os.tmpdir(), 'hostlog-selftest2-' + process.pid);
const ROOT3 = path.join(os.tmpdir(), 'hostlog-selftest3-' + process.pid);
const ROOT4 = path.join(os.tmpdir(), 'hostlog-selftest4-' + process.pid);
const ROOT5 = path.join(os.tmpdir(), 'hostlog-selftest5-' + process.pid);
let pass = 0, fail = 0;

function mk(root, rel, text) {
  const p = path.join(root, rel);
  fs.mkdirSync(path.dirname(p), { recursive: true });
  fs.writeFileSync(p, text);
}

/* 真形状的宿主日志行：JSON + `"timestamp"` + `message` 数组。 */
function logline(ts, msg) {
  return JSON.stringify({
    timestamp: ts, level: 'info',
    scope: 'daemon-server:ServerAutomationExecutor', message: [msg],
  });
}

function check(title, got, want) {
  const ok = JSON.stringify(got) === JSON.stringify(want);
  console.log((ok ? 'PASS  ' : 'FAIL  ') + title +
    (ok ? '' : '\n      got  = ' + JSON.stringify(got) + '\n      want = ' + JSON.stringify(want)));
  if (ok) pass++; else fail++;
}

const A = 'aaaa1111-2222-3333-4444-555555555555';
const B = 'bbbb1111-2222-3333-4444-555555555555';
const T = Date.parse('2099-01-02T03:04:05.000Z');
const iso = (ms) => new Date(ms).toISOString();

/* 账本行 —— 与 `acceptance.js` 收尾写的那一行**同一格式**。 */
function ledgerLine(ms, exit, ok, fail_, drift, unver) {
  return iso(ms) + ' exit=' + exit + ' ok=' + ok + ' fail=' + fail_ +
    ' drift=' + drift + ' unver=' + unver;
}

try {
  /* ---- 1 · 三类行混在一份日志里 ---- */
  mk(ROOT, '2099-01-01/a.log', [
    /* 宿主 spawn 了一个**插件** hook —— 不算我的 */
    '[Info] [pid=1] [HookExecutor] spawn pid=11 shell=bash cmd=bash "/x/plugins/cache/foo/setup.sh"',
    /* **我自己**在 Bash 里跑了一次 hook —— 含 .check/，但**不是宿主 spawn**，不许算 */
    '[Info] [pid=2] [BashTool] execute start | command="bash .check/hook-post-edit.sh"',
    /* 宿主 spawn 了**我的** hook —— 只有这一行算 */
    '[Info] [pid=3] [HookExecutor] spawn pid=12 shell=bash cmd=bash "C:/u/.workbuddy-ai/.check/hook-post-edit.sh"',
    '（无关的一行）',
  ].join('\n') + '\n');
  const r1 = scanHostLogs(ROOT);
  check('1 只有宿主 spawn 的 .check/ 才算（我自己的 Bash 调用不算）',
    { ok: r1.ok, mine: r1.mine, spawnTotal: r1.spawnTotal, files: r1.files },
    { ok: true, mine: 1, spawnTotal: 2, files: 1 });

  /* ---- 2 · 没有任何 .check/ 的 spawn ---- */
  mk(ROOT2, '2099-01-02/b.log',
    '[Info] [HookExecutor] spawn pid=21 cmd=bash "/x/plugins/cache/bar/setup.sh"\n');
  const r2 = scanHostLogs(ROOT2);
  check('2 没有 .check/ 时 mine=0', { ok: r2.ok, mine: r2.mine, spawnTotal: r2.spawnTotal },
    { ok: true, mine: 0, spawnTotal: 1 });

  /* ---- 3 · 取**最新**的日期目录：老目录里有命中也不该被读到 ---- */
  mk(ROOT, '2099-02-01/c.log',
    '[Info] [HookExecutor] spawn pid=31 cmd=bash "/x/plugins/cache/baz/setup.sh"\n');
  const r3 = scanHostLogs(ROOT);
  check('3 只看最新日期目录（2099-01-01 里那条 .check/ 命中不该被读到）',
    { day: r3.day, mine: r3.mine, files: r3.files }, { day: '2099-02-01', mine: 0, files: 1 });

  /* ---- 4 · 读不到目录 -> ok:false（**不是** mine:0） ---- */
  const r4 = scanHostLogs(path.join(ROOT, '不存在'));
  check('4 读不到目录报 ok=false（第三态，不是「0 次」）',
    { ok: r4.ok, mine: r4.mine }, { ok: false, mine: 0 });

  /* ---- 5 · 超预算 -> complete:false（不许假装扫完了） ---- */
  mk(ROOT3, '2099-01-03/big.log', 'x'.repeat(4096));
  const r5 = scanHostLogs(ROOT3, 1024);
  check('5 超预算报 complete=false', { ok: r5.ok, complete: r5.complete, files: r5.files },
    { ok: true, complete: false, files: 0 });

  /* ---- 6 · automation：`execute result` 不算运行记录，只有 `terminal run record written` 才算 ---- */
  mk(ROOT, 'daemon.log', [
    logline(iso(T), '[AutomationRecords] execute result automationId=' + A + ', runId=' + A + ':1, accepted=true, success=true, deferred=false'),
    logline(iso(T + 1000), '[AutomationRecords] terminal run record written automationId=' + A + ', runId=' + A + ':1, status=ACCEPTED, sessionId=78fff88d'),
  ].join('\n') + '\n');
  const r6 = scanHostLogs(ROOT);
  check('6 automation：只认 terminal run record written，且时间戳要解析出来',
    { n: r6.autoRuns.length, first: r6.autoRuns[0] },
    /* `sessionId` 也在断言里 —— 它是 [98] 因果链的钥匙，**漏抓了整条链就断了**，
     * 而漏抓不会报错，只会退化成「因果未确认」。所以必须在这里钉住。 */
    { n: 1, first: { id: A, status: 'ACCEPTED', t: T + 1000, sessionId: '78fff88d', finishedAt: null } });

  /* ---- 7 · 失败状态要能被解析出来（判定逻辑在 host-log，这里只证解析） ---- */
  mk(ROOT, 'daemon.log', [
    logline(iso(T), '[AutomationRecords] terminal run record written automationId=' + A + ', runId=' + A + ':1, status=ACCEPTED, sessionId=78fff88d'),
    logline(iso(T + 1000), '[AutomationRecords] terminal run record written automationId=' + B + ', runId=' + B + ':1, status=FAILED, sessionId=deadbeef'),
  ].join('\n') + '\n');
  const r7 = scanHostLogs(ROOT);
  check('7 第二个 automation 的 FAILED 也被解析出来',
    { n: r7.autoRuns.length, second: r7.autoRuns[1] },
    { n: 2, second: { id: B, status: 'FAILED', t: T + 1000, sessionId: 'deadbeef', finishedAt: null } });

  /* ---- 8 · automation 的行在**根目录**的 daemon.log 里，不在日期目录里 ---- */
  const r8 = scanHostLogs(ROOT);
  check('8 根目录的 daemon.log 也被扫到（automation 记录在那里）',
    { day: r8.day, n: r8.autoRuns.length, files: r8.files },
    { day: '2099-02-01', n: 2, files: 2 });

  /* ---- 9 · 没有时间戳 -> t=null，**不许拿「现在」顶替** ---- */
  mk(ROOT2, 'daemon.log',
    logline('', '[AutomationRecords] terminal run record written automationId=' + A + ', status=ACCEPTED') + '\n');
  const r9 = scanHostLogs(ROOT2);
  check('9 时间戳取不到就报 null（不猜成「现在」）',
    { n: r9.autoRuns.length, t: r9.autoRuns[0] && r9.autoRuns[0].t },
    { n: 1, t: null });

  /* ---- 10 · 账本解析：合法行认，垃圾行丢掉 ---- */
  const led = parseLedger([
    ledgerLine(T, 2, 7, 0, 0, 2),
    '',
    '这不是账本行，是一句人话',
    ledgerLine(T + 86400000, 0, 9, 0, 0, 0),
  ].join('\n'));
  check('10 账本解析：合法行认、垃圾行丢',
    { n: led.length, first: led[0], last: led[1] },
    { n: 2, first: { t: T, exit: 2, ok: 7, fail: 0, drift: 0, unver: 2 },
      last: { t: T + 86400000, exit: 0, ok: 9, fail: 0, drift: 0, unver: 0 } });

  /* ---- 11 · 配对：没有运行记录 = **未到点**（不是「跑了没产出」） ----
   * 后面几条一律显式传 `now` —— **判定不许取决于真实时钟**，
   * 否则这几条会随「什么时候跑测试」变红或变绿（与「断言不许取决于运行次数」同族）。 */
  const N12 = T + 5 * 60000;
  const p11 = pairRunWithLedger([], [ { t: T, exit: 2, ok: 7, fail: 0, drift: 0, unver: 2 } ], A,
    { now: N12 });
  check('11 没有运行记录 -> UNVERIFIED（未到点，不是「没产出」）',
    { state: p11.state, line: p11.line }, { state: 'UNVERIFIED', line: null });

  /* ---- 12 · 配对：运行记录在 + 账本行落在窗口内 -> OK ----
   * 账本行在运行**之后 4 分钟** —— 这是真实形状（acceptance 要跑约 4 分钟）。 */
  const p12 = pairRunWithLedger(
    [ { id: A, status: 'ACCEPTED', t: T } ],
    [ { t: T + 4 * 60000, exit: 2, ok: 7, fail: 0, drift: 0, unver: 2 } ], A, { now: N12 });
  check('12 运行记录 + 窗口内账本行 -> OK', { state: p12.state, ok: p12.line && p12.line.ok },
    { state: 'OK', ok: 7 });

  /* ---- 13 · 配对：运行记录在、账本没有 -> **触发了但没产出** ---- */
  const p13 = pairRunWithLedger([ { id: A, status: 'ACCEPTED', t: T } ], [], A, { now: N12 });
  check('13 有运行记录、无账本行 -> FAIL（触发了但没产出）',
    { state: p13.state, why: /没产出/.test(p13.why) }, { state: 'FAIL', why: true });

  /* ---- 14 · 配对：运行本身失败 -> FAIL（不是「没产出」） ---- */
  const p14 = pairRunWithLedger([ { id: A, status: 'FAILED', t: T } ],
    [ { t: T + 60000, exit: 1, ok: 0, fail: 1, drift: 0, unver: 0 } ], A, { now: N12 });
  check('14 status=FAILED -> FAIL', { state: p14.state, why: /没成功/.test(p14.why) },
    { state: 'FAIL', why: true });

  /* ---- 15 · 配对：status 认不出 -> DRIFT，**不许猜成成功** ---- */
  const p15 = pairRunWithLedger([ { id: A, status: 'WEIRD_STATE', t: T } ],
    [ { t: T + 60000, exit: 0, ok: 9, fail: 0, drift: 0, unver: 0 } ], A, { now: N12 });
  check('15 status 认不出 -> DRIFT（不猜成成功）', { state: p15.state, line: p15.line },
    { state: 'DRIFT', line: null });

  /* ---- 16 · 配对：账本行在窗口**外**（太旧）-> FAIL，不许配到陈年那一条 ----
   * 边界用 PAIR_AFTER_MS 本身算，不写死 30 —— 改窗口时这条不会静默失准。 */
  const p16 = pairRunWithLedger([ { id: A, status: 'ACCEPTED', t: T } ],
    [ { t: T + PAIR_AFTER_MS + 60000, exit: 0, ok: 9, fail: 0, drift: 0, unver: 0 } ], A, { now: N12 });
  check('16 账本行在窗口外（太旧）-> FAIL', { state: p16.state, line: p16.line },
    { state: 'FAIL', line: null });

  /* ---- 17 · 新鲜度闸门：**陈旧的一对配在一起不是证据，是巧合** ----
   * 这条是「陈旧 OK」的守门人：日志里只剩三天前的运行记录、账本里也只剩三天前那一行，
   * 两边**仍然配得上** —— 没有闸门就会报「它产出过」，而真相是「它已经三天没跑了」。
   * 超过 PAIR_MAX_AGE_MS 一律 UNVERIFIED：日志滚掉了 / 日报停了，两者无法区分。 */
  const p17 = pairRunWithLedger([ { id: A, status: 'ACCEPTED', t: T } ],
    [ { t: T + 4 * 60000, exit: 2, ok: 7, fail: 0, drift: 0, unver: 2 } ], A,
    { now: T + PAIR_MAX_AGE_MS + 3600000 });
  check('17 运行记录超期 -> UNVERIFIED（陈旧配对不许报 OK）',
    { state: p17.state, line: p17.line }, { state: 'UNVERIFIED', line: null });

  /* ---- 18 · `daemon.old.log` 也要扫（留存期是约束，陈旧由闸门管） ---- */
  const ROOT4 = path.join(os.tmpdir(), 'hostlog-selftest4-' + process.pid);
  mk(ROOT4, '2099-01-05/x.log', '（无关）\n');
  mk(ROOT4, 'daemon.old.log',
    logline(iso(T), '[AutomationRecords] terminal run record written automationId=' + A + ', status=ACCEPTED') + '\n');
  const r18 = scanHostLogs(ROOT4);
  check('18 daemon.old.log 也被扫到（跳过它等于砍掉一半留存期）',
    { n: r18.autoRuns.length, files: r18.files }, { n: 1, files: 2 });
  try { fs.rmSync(ROOT4, { recursive: true, force: true }); } catch (e) { /* 未验证，不报失败 */ }

  /* ---- 19 · 扫描未完成时，「没有运行记录」推不出「没跑」 ----
   * 与第 11 条同样是 UNVERIFIED，但**原因必须不同**：
   * 11 是「未到点」（扫描完整，确实没有记录），19 是「没测」（扫描不完整，可能在没读到的文件里）。
   * 把这两种原因压成一句话，就会把一个「没测」读成「没有」。 */
  const p19 = pairRunWithLedger([], [ { t: T, exit: 2, ok: 7, fail: 0, drift: 0, unver: 2 } ], A,
    { now: N12, scanComplete: false });
  check('19 扫描未完成 -> UNVERIFIED，且原因与「未到点」不同',
    { state: p19.state, 未完成: /未完成/.test(p19.why), 未到点: /未到点/.test(p19.why) },
    { state: 'UNVERIFIED', 未完成: true, 未到点: false });

  /* ---- 20 · 左边界：账本行**早于**运行记录 10 分钟，仍要算 OK ----
   * 这是「假红守门人」。探针实测：运行记录是在**整轮跑完之后**才落盘的
   * （35 秒的活，记录写在收尾）。那条 automation 要跑 acceptance（约 4 分钟）
   * 再写汇报，所以记录可能比账本行晚好几分钟。
   * 原来的左边界是 2 分钟 —— 会把「跑了、也有产出」判成「触发了但没产出」。
   * 假红会训练人忽略红色，**比漏报更贵**。 */
  const p20 = pairRunWithLedger([ { id: A, status: 'ACCEPTED', t: T } ],
    [ { t: T - 10 * 60000, exit: 2, ok: 7, fail: 0, drift: 0, unver: 2 } ], A,
    { now: T + 60000 });
  check('20 账本行早于记录 10 分钟 -> 仍 OK（左边界够宽，不制造假红）',
    { state: p20.state, 早: p20.deltaMs < 0 }, { state: 'OK', 早: true });

  /* ---- 21 · 左边界外：早 16 分钟 -> FAIL（窗口不能无限宽） ---- */
  const p21 = pairRunWithLedger([ { id: A, status: 'ACCEPTED', t: T } ],
    [ { t: T - 16 * 60000, exit: 2, ok: 7, fail: 0, drift: 0, unver: 2 } ], A,
    { now: T + 60000 });
  check('21 账本行早于记录 16 分钟 -> FAIL（左边界外）',
    { state: p21.state, cand: p21.cand }, { state: 'FAIL', cand: 0 });

  /* ---- 22 · 窗口内多行候选时，取**最接近运行时刻**的那一行 ----
   * 我手动跑一次也会写一行账本 —— 取最后一行会取到不相干的那次。 */
  const p22 = pairRunWithLedger([ { id: A, status: 'ACCEPTED', t: T } ], [
    { t: T - 3 * 60000, exit: 2, ok: 7, fail: 0, drift: 0, unver: 2 },
    { t: T + 5 * 60000, exit: 0, ok: 9, fail: 0, drift: 0, unver: 0 },
    { t: T + 2 * 60000, exit: 1, ok: 3, fail: 1, drift: 0, unver: 0 },
  ], A, { now: T + 60000 });
  check('22 多候选时取最接近运行时刻的那一行',
    { state: p22.state, cand: p22.cand, exit: p22.line && p22.line.exit },
    { state: 'OK', cand: 3, exit: 1 });
  /* ---- 23..30 · 因果链（2026-09-15 加） ----
   * 时间窗口配对只能证明「那一刻**有人**跑过 acceptance」，证明不了**是这一轮 automation 跑的**。
   * 而这条很重要：我的规矩是「会话第一件事跑 acceptance」，若人正好在日报落盘前后手动跑一次，
   * 两条时间线会落在同一个 ±15 分钟窗口里 —— [98] 会给假 OK，盖住「日报根本没执行命令」。
   * 宿主把 `sessionId` 写进了运行记录，那一轮的会话日志里记着它执行过的命令 —— 用它把
   * 「同时发生」升级成「就是它」。 */
  const RUN = { id: A, status: 'ACCEPTED', t: T, sessionId: 'S1', finishedAt: T + 4 * 60000 };
  const L = (t) => ({ t, exit: 2, ok: 7, fail: 0, drift: 0, unver: 2 });
  const CMD = { t: T, cmd: 'cd x && node .check/acceptance.js', done: true };

  /* `null` 与 `[]` 必须分开：「读不到」是没信息（第三态），「读到了但没那条命令」是没执行。
   * 压成一种，就会把「没测」读成「没跑」—— 同一个坑第三次出现。 */
  const c23 = causalPair(RUN, null, [L(T + 4 * 60000)]);
  check('23 会话日志读不到 -> UNVERIFIED（**没信息**，不等于「没执行」）',
    { state: c23.state, 因果没确认: /因果没确认/.test(c23.why), 没执行: /没有执行/.test(c23.why) },
    { state: 'UNVERIFIED', 因果没确认: true, 没执行: false });

  const c24 = causalPair(RUN, [], [L(T + 4 * 60000)]);
  check('24 会话日志里没有那条命令 -> FAIL（确实没执行；与「执行了但崩了」查的方向不同）',
    { state: c24.state, 没有执行: /没有执行/.test(c24.why) },
    { state: 'FAIL', 没有执行: true });

  const c25 = causalPair(RUN, [CMD], [L(T + 4 * 60000)]);
  check('25 会话里执行过 + 账本在命令后 4 分钟 -> OK 且**因果已确认**',
    { state: c25.state, causal: c25.causal, deltaMin: Math.round(c25.deltaMs / 60000) },
    { state: 'OK', causal: true, deltaMin: 4 });

  const c26 = causalPair(RUN, [CMD], [L(T + 40 * 60000)]);
  check('26 账本在命令后 40 分钟 -> FAIL（上界 30 分钟外）',
    { state: c26.state, 没跑到收尾: /没跑到收尾/.test(c26.why) },
    { state: 'FAIL', 没跑到收尾: true });

  const c27 = causalPair(RUN, [CMD], [L(T - 1000)]);
  check('27 账本**早于**命令 1 秒 -> FAIL（下界不许提前：账本只能写在命令之后）',
    { state: c27.state }, { state: 'FAIL' });

  const c28 = causalPair(RUN,
    [CMD, { t: T + 60 * 60000, cmd: 'node .check/acceptance.js', done: true }],
    [L(T + 64 * 60000)]);
  check('28 执行过两次时配**最近**那一次（不是第一次）',
    { state: c28.state, deltaMin: Math.round(c28.deltaMs / 60000) },
    { state: 'OK', deltaMin: 4 });

  /* 会话日志里的时间戳是**不带引号的毫秒数**，daemon.log 里是**带引号的 ISO 串**。
