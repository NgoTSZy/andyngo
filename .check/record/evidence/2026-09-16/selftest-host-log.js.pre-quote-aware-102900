  check('41 交叉核对：宿主窗口内 0 次、自述有 → 不判红，且要说明「窗口不一样大」',
    (() => { const r = crossCheckHookExit(hx({}), vt({ hit: 3 }));
      return { state: r.state, 提到窗口: /窗口/.test(r.why) }; })(),
    { state: 'OK', 提到窗口: true });

  check('42 交叉核对：两侧都 0 → 无提示（没异常时不许刷提示）',
