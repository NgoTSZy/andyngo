  for (const d of [ROOT, ROOT2, ROOT3, ROOT4, ROOT5]) {
    try { fs.rmSync(d, { recursive: true, force: true }); } catch (e) { /* 未验证，不报失败 */ }
  }
}

console.log('----');
console.log('自测 ' + (pass + fail) + ' 条：命中 ' + pass + ' / 失败 ' + fail);
process.exit(fail ? 1 : 0);
