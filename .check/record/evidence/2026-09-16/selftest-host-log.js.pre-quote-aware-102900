  };
  /* 被执行的目标脚本，内容含 acceptance.js —— 指针链要能顺下去。 */
  mk(ROOT5, 'audit.sh', '#!/bin/sh\n( cd "$ROOT" && node .check/acceptance.js 2>&1 )\n');
  const hr = (s) => { const t = parseWorkspaceTs(s); return t === null ? null : new Date(t).getHours(); };
  check('48 parseWorkspaceTs 认工作区日志的时间戳（12 小时制 + 中文上下午）',
    { 上午9: hr('[16/9/2026 上午9:08:07.359] x'),
      下午3: hr('[16/9/2026 下午3:30:00.000] x'),
      下午12: hr('[16/9/2026 下午12:05:00.000] x'),
      上午12: hr('[16/9/2026 上午12:05:00.000] x'),
      认不出: parseWorkspaceTs('2026-09-16T01:08:07.359Z') },
    { 上午9: 9, 下午3: 15, 下午12: 12, 上午12: 0, 认不出: null });

  check('49 cmdRunsAcceptance 只认「执行」，不认「读」也不认「提到」（子串判断会在这里出错）',
    { 直接: cmdRunsAcceptance('cd /x && node .check/acceptance.js 2>&1', ROOT5),
      指针链: cmdRunsAcceptance('cd /x && bash audit.sh; echo 1', ROOT5),
      读文件: cmdRunsAcceptance('cd /x && grep -n "exitCode" .check/acceptance.js | tail -25', ROOT5),
      提到: cmdRunsAcceptance('echo "见 .check/acceptance.js"', ROOT5),
      脚本不在: cmdRunsAcceptance('cd /x && bash nope.sh', ROOT5) },
    { 直接: true, 指针链: true, 读文件: false, 提到: false, 脚本不在: false });

  mk(ROOT5, 'logs/' + DAY5 + '/.ws__a.log', wsLog([sidX], ['cd /x && bash audit.sh; echo 1']));
  const f1 = findSessionAcceptanceRuns(path.join(ROOT5, 'logs'), DAY5, sidX, null);
  check('50 ★单会话 + `bash audit.sh`（脚本内含 acceptance）→ **命中**，且时间解析得出',
    { 是数组: Array.isArray(f1), 条数: f1 ? f1.length : null,
      有t: !!(f1 && f1[0] && Number.isFinite(f1[0].t)) },
    { 是数组: true, 条数: 1, 有t: true });

  mk(ROOT5, 'logs/' + DAY5B + '/.ws__b.log',
    wsLog([sidX], ['cd /x && grep -n "exitCode" .check/acceptance.js | tail -25']));
  const f2 = findSessionAcceptanceRuns(path.join(ROOT5, 'logs'), DAY5B, sidX, null);
  check('51 ★只有 `grep … acceptance.js`（**读**）→ 返回 []（不是 null、也不是命中）',
    { 是数组: Array.isArray(f2), 条数: f2 ? f2.length : null },
    { 是数组: true, 条数: 0 });

  mk(ROOT5, 'logs/' + DAY5C + '/.ws__c.log', wsLog([sidX, sidY], ['cd /x && bash audit.sh']));
  const f3 = findSessionAcceptanceRuns(path.join(ROOT5, 'logs'), DAY5C, sidX, null);
  check('52 ★该文件里 sessionId **不唯一**（并发）→ 返回 null（归属不了，宁可说不知道）',
    { 值: f3 }, { 值: null });
} catch (e) {
